{
  "name": "khulula-api",
  "version": "1.0.0",
  "description": "Back-end API for Centre Khulula",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "migrate": "prisma migrate dev",
    "seed": "prisma db seed",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "argon2": "^0.45.1",
    "connect-redis": "^10.0.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "redis": "^6.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.2.0",
    "prisma": "^6.14.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
