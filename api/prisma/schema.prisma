// Database schema for Centre Khulula — docs/conception/modele-donnees.md in the
// Prisma language. Read that document first: it explains why the model is this
// shape. The model name is used in the code (Animal), the @@map is the real
// table name (animal), snake_case as in the MPD.
//
// What Prisma cannot express is hand-written SQL in the migrations instead: the
// partial unique index (RG1), the trigger on enclosure.status (RG3, RG7), the
// CHECK constraints, and the two database accounts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enumerations — modele-donnees.md §4.2. Checked by the database itself: a
// misspelled value is rejected on write, not stored.
// ---------------------------------------------------------------------------

enum StaffRole {
  keeper
  veterinarian

  @@map("staff_role")
}

// The animal lifecycle — RG4. released and deceased are terminal states (RG5).
enum AnimalStatus {
  admitted
  in_care
  recovering
  released
  deceased

  @@map("animal_status")
}

enum EnclosureStatus {
  free
  occupied
  maintenance

  @@map("enclosure_status")
}

enum EnclosureType {
  small_mammal
  large_mammal
  aviary
  reptile

  @@map("enclosure_type")
}

enum IucnStatus {
  least_concern
  near_threatened
  vulnerable
  endangered
  critically_endangered

  @@map("iucn_status")
}

enum Sex {
  male
  female
  unknown

  @@map("sex")
}

enum AgeClass {
  juvenile
  subadult
  adult
  unknown

  @@map("age_class")
}

// ---------------------------------------------------------------------------
// Tables
// ---------------------------------------------------------------------------

// A member of staff. Named staff_member and not user, because user is a
// reserved word in PostgreSQL.
model StaffMember {
  id            Int       @id @default(autoincrement())
  full_name     String    @db.VarChar(100)
  // The login identifier.
  email         String    @unique @db.VarChar(255)
  // Hashed with argon2. The clear password is never stored, never logged.
  password_hash String    @db.VarChar(255)
  role          StaffRole
  // Second axis of rights: administering the tool, not the animals.
  // Never granted from the interface — RG13.
  is_admin      Boolean   @default(false)
  // An account is deactivated, never deleted — RG12.
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)

  observations     Observation[]
  stays_opened     Stay[]
  animals_released Animal[]

  @@map("staff_member")
}

// Reference data: seeded, then changed by migration. The species pages of the
// public site are built from this table.
model Species {
  id              Int        @id @default(autoincrement())
  common_name     String     @db.VarChar(100)
  scientific_name String     @unique @db.VarChar(100)
  iucn_status     IucnStatus
  habitat         String     @db.VarChar(255)
  diet            String     @db.VarChar(255)
  activity        String     @db.VarChar(255)
  description     String     @db.Text
  photo_url       String     @db.VarChar(255)

  // The kind of enclosure this species belongs in (RG17). A jackal does not go
  // in an aviary, and the rule needs a column to be checked against.
  enclosure_type  EnclosureType

  animals Animal[]

  @@map("species")
}

model Enclosure {
  id                   Int             @id @default(autoincrement())
  // E-01, E-02, ...
  code                 String          @unique @db.VarChar(10)
  type                 EnclosureType
  notes                String?         @db.Text
  // A decision, taken by an administrator, and only on a free enclosure — RG16.
  is_under_maintenance Boolean         @default(false)
  // A consequence, written by the trigger only. The application reads it and
  // never sets it — RG3.
  status               EnclosureStatus @default(free)

  stays Stay[]

  @@map("enclosure")
}

model Animal {
  id   Int    @id @default(autoincrement())
  // Mandatory but NOT unique: two servals may both be called Nala. The animal is
  // identified by its id — see modele-donnees.md §4.1.
  name String @db.VarChar(100)

  species_id Int
  species    Species @relation(fields: [species_id], references: [id], onDelete: Restrict)

  sex              Sex
  age_class        AgeClass
  // A place name, never GPS coordinates, and never shown publicly — RG11.
  found_near       String?  @db.VarChar(255)
  admission_reason String   @db.Text

  status      AnimalStatus @default(admitted)
  admitted_at DateTime     @db.Timestamptz(6)

  // The three outcome columns stay empty until an outcome is pronounced, and are
  // filled together — RG5. Only a veterinarian may fill them — RG6.
  outcome_at    DateTime?    @db.Timestamptz(6)
  outcome_note  String?      @db.Text
  outcome_by_id Int?
  outcome_by    StaffMember? @relation(fields: [outcome_by_id], references: [id], onDelete: Restrict)

  stays        Stay[]
  observations Observation[]

  // Speeds up the public lists, which always filter on status — screen 4.
  @@index([status])
  @@map("animal")
}

// One animal in one enclosure, for one period. An animal that is moved gets a
// second stay rather than losing the first one — RG8.
model Stay {
  id Int @id @default(autoincrement())

  animal_id Int
  animal    Animal @relation(fields: [animal_id], references: [id], onDelete: Restrict)

  enclosure_id Int
  enclosure    Enclosure @relation(fields: [enclosure_id], references: [id], onDelete: Restrict)

  started_at  DateTime  @db.Timestamptz(6)
  // Empty means "stay in progress". This single fact drives the enclosure status,
  // the length of stay and the occupancy rate — see modele-donnees.md §3.2.
  ended_at    DateTime? @db.Timestamptz(6)
  // Only filled when the stay was opened by a move, not by an admission.
  move_reason String?   @db.Text

  opened_by_id Int
  opened_by    StaffMember @relation(fields: [opened_by_id], references: [id], onDelete: Restrict)

  @@index([animal_id])
  @@index([enclosure_id])
  @@map("stay")
}

// Append-only: no update, no delete. The rule is not only written in the code,
// it is removed from the grants of the khulula_app account — §5.6.
model Observation {
  id Int @id @default(autoincrement())

  animal_id Int
  animal    Animal @relation(fields: [animal_id], references: [id], onDelete: Restrict)

  author_id Int
  author    StaffMember @relation(fields: [author_id], references: [id], onDelete: Restrict)

  observed_at  DateTime      @db.Timestamptz(6)
  body         String        @db.Text
  // Only filled when the observation makes the animal change status.
  status_after AnimalStatus?

  @@index([animal_id])
  @@index([author_id])
  @@map("observation")
}

// A donation records an INTENTION only. No payment provider, no card fields, ever.
// It has no foreign key at all: a donation is attached to nobody — RG10.
model Donation {
  id     Int     @id @default(autoincrement())
  // Decimal and never Float: floating point numbers round amounts.
  amount Decimal @db.Decimal(7, 2)

  // The three donor fields stay empty for an anonymous donation.
  donor_name  String? @db.VarChar(100)
  donor_email String? @db.VarChar(255)
  message     String? @db.Text

  consent_given Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@map("donation")
}
