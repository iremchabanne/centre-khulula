# Copy this file to .env and fill in the real password:
#     cp .env.example .env
#
# Two .env files exist in this project, on purpose:
#   ../.env    configures the Docker containers (what the database IS)
#   ./.env     configures the API                (how the API REACHES it)
# The password is the same value in both — POSTGRES_PASSWORD at the root.

# Two database accounts, on purpose — see modele-donnees.md §5.6 and the
# migration 20260822105239_application_database_account.

# khulula_admin — owns the tables. Used by `prisma migrate`, backup and restore.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://khulula_admin:change_me_in_your_env_file@localhost:5432/khulula"

# khulula_app — the only account the running API uses. Restricted rights: no
# DELETE anywhere, no UPDATE on observation, read-only on species.
#
# The migration creates this role WITHOUT a password, because migrations are
# committed. Set one yourself, once:
#     docker exec khulula-postgres psql -U khulula_admin -d khulula \
#         -c "ALTER ROLE khulula_app PASSWORD 'the-password-you-put-below';"
DATABASE_URL_APP="postgresql://khulula_app:change_me_in_your_env_file@localhost:5432/khulula"
