# Copy this file to .env and fill in the real password:
#     cp .env.example .env
#
# Two .env files exist in this project, on purpose:
#   ../.env    configures the Docker containers (what the database IS)
#   ./.env     configures the API                (how the API REACHES it)
# The password is the same value in both — POSTGRES_PASSWORD at the root.

# Connection string read by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://khulula_admin:change_me_in_your_env_file@localhost:5432/khulula"
