# Production image for the API. The development one watches the mounted source;
# this one copies the code in and starts it once.

FROM node:24-alpine

WORKDIR /app

# npm ci installs the exact versions of package-lock.json; --omit=dev leaves
# out ESLint and Vitest.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY . .

RUN npx prisma generate

# migrate deploy applies the migrations already written and never creates one,
# unlike migrate dev. The seed runs too: this deployment is a demonstration, so
# it starts from the same sample data every time.
CMD ["sh", "-c", "npx prisma migrate deploy && npx prisma db seed && npx tsx src/server.ts"]
