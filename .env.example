# Copy this file to .env and fill in real values:
#     cp .env.example .env
#
# .env is git-ignored and never committed. This file is the documented list of
# what the stack needs — it is committed on purpose, with fake values only.

# --- PostgreSQL ---
POSTGRES_USER=khulula_admin
POSTGRES_PASSWORD=change_me_in_your_env_file
POSTGRES_DB=khulula
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=change_me_in_your_env_file
REDIS_PORT=6379

# --- Adminer ---
ADMINER_PORT=8080

# --- API and client, when they run inside Docker ---
# Same two values as in api/.env. They are here as well because Compose builds
# the container's DATABASE_URL_APP and SESSION_SECRET from them, and Compose
# cannot read api/.env. Both files are git-ignored; change a value in one and
# you must change it in the other.
APP_DB_PASSWORD=change_me_in_your_env_file
SESSION_SECRET=change_me_in_your_env_file

API_PORT=3000
CLIENT_PORT=5173
