# Dependencies
node_modules/

# Environment — never commit secrets
.env
.env.*
!.env.example

# Build output
dist/
build/
coverage/

# Logs
*.log
npm-debug.log*

# Database backups. The scripts that make them are committed; the dumps
# themselves are not — they hold every row of the database.
backups/

# OS
.DS_Store

# Reference material belonging to someone else — kept locally, never published
message.txt

# Personal command cheat-sheet, written in Turkish — a working note, not a deliverable
KOMUTLAR.md

# Screenshots for the DP, and the list of which ones to take. These go into the
# DP document itself, not into the repository: they are personal exam material,
# and image files would grow the repository for no benefit.
docs/dp/captures.md
docs/dp/captures/
